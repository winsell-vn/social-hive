{
  "name": "chungtoixayweb-backend",
  "version": "1.0.0",
  "description": "ChungToiXayWeb Social Blog Platform Backend",
  "scripts": {
    "build": "nest build",
    "dev": "npm run start:dev",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "redis:start": "ts-node scripts/start-redis.ts",
    "redis:check": "ts-node -e \"require('./scripts/start-redis').ensureRedisRunning().then(r => process.exit(r ? 0 : 1))\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:seed:pricing": "ts-node prisma/seed-pricing.ts",
    "audit": "npm audit"
  },
  "dependencies": {
    "@nestjs/bull": "^11.0.5",
    "@nestjs/common": "^11.2.9",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.9",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.9",
    "@nestjs/schedule": "^6.1.0",
    "@nestjs/terminus": "^11.1.1",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "^5.7.0",
    "bcrypt": "^6.0.0",
    "bull": "^4.16.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "ioredis": "^5.3.2",
    "lru-cache": "^11.2.6",
    "nest-winston": "^1.10.2",
    "nodemailer": "^10.4.0",
    "otplib": "^13.2.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.1.13",
    "resend": "^6.9.2",
    "rxjs": "^7.8.1",
    "sharp": "^0.35.5",
    "winston": "^3.19.0"
  },
  "overrides": {
    "minimatch": ">=11.0.5",
    "ajv": ">=8.18.0",
    "glob": ">=14.0.4",
    "qs": ">=6.16.1",
    "multer": ">=2.5.0",
    "uuid": ">=11.1.1 <12",
    "micromatch": {
      "picomatch": ">=2.3.2"
    },
    "anymatch": {
      "picomatch": ">=2.3.2"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.9",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.3.1",
    "@types/passport-jwt": "^3.0.13",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.7.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8.56.0"
  }
}
