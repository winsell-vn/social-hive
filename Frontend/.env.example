# ==============================================================
#  SocialHive - Frontend environment template
#
#  Copy to `.env.local` and fill in real values:
#      cp .env.example .env.local
#
#  NEVER commit your real `.env.local`. It is git-ignored by default.
#  All NEXT_PUBLIC_* values are exposed to the browser.
# ==============================================================

# Base URL of the backend API (including the /api prefix)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# WebSocket endpoint used for realtime features
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Public site origin, used for canonical URLs and sitemap
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Production domain used for the HTTP -> HTTPS redirect
NEXT_PUBLIC_DOMAIN=localhost

# --------------------------------------------------------------
#  Cloudflare Turnstile (CAPTCHA) site key
#  Safe to expose: it is a public key by design.
# --------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --------------------------------------------------------------
#  Analytics & verification
# --------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_GA_MEASUREMENT_ID=
