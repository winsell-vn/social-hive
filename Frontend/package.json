{
  "name": "chungtoixayweb-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "cross-env NODE_ENV=production next build",
    "postbuild": "node -e \"const fs=require('fs');fs.cpSync('.next/static','.next/standalone/.next/static',{recursive:true});fs.cpSync('public','.next/standalone/public',{recursive:true})\"",
    "start": "next start",
    "start:prod": "node .next/standalone/server.js",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
